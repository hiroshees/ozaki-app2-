{
  "name": "nextjs-app-template1",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "postinstall": "prisma generate",
    "start": "next start",
    "lint": "next lint --dir src --dir test",
    "typecheck": "tsc --skipLibCheck true --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "vercel-build": "prisma generate && next build",
    "prisma:migrate:dev": "npx dotenv -e .env.local -- npx prisma migrate dev --name init",
    "prettier": "prettier -w src/ test/",
    "prettier:check": "prettier --check src/ test/"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@fullcalendar/react": "^7.1.3",
    "@hookform/resolvers": "^4.0.0",
    "@prisma/client": "^6.19.3",
    "@supabase/ssr": "^0.5.2",
    "@supabase/supabase-js": "^2.48.1",
    "entities": "^6.0.0",
    "next": "15.1.7",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-hook-form": "^7.54.2",
    "react-icons": "^5.4.0",
    "server-only": "^0.0.1",
    "tailwind-merge": "^3.0.2",
    "tailwind-variants": "^1.0.0",
    "temporal-polyfill": "^1.0.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^5.0.5",
    "dotenv-cli": "^8.0.0",
    "eslint": "^9",
    "eslint-config-next": "15.1.7",
    "postcss": "^8",
    "prettier": "^3.9.10",
    "prisma": "^6.19.3",
    "tailwindcss": "^3.4.1",
    "tsx": "^4.19.2",
    "typescript": "^5",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "prisma": {
    "schema": "src/db/prisma/schema.prisma"
  }
}
