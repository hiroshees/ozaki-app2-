{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(yarn run dev)",
      "Bash(yarn lint)",
      "Bash(yarn test *)",
      "Bash(npx vitest *)",
      "Bash(npx tsc --noEmit)",
      "Read(./.env)",
      "Read(./.env.local)",
      "Read(./.env.*.local)"
    ],
    "ask": [
      "Bash(supabase db push *)",
      "Bash(supabase db reset *)",
      "Bash(supabase migration repair *)",
      "Bash(vercel --prod *)"
    ],
    "deny": ["Edit(./.env)", "Edit(./.env.local)", "Edit(./.env.*.local)"]
  }
}
